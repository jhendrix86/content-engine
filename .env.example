# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/content

# Redis
REDIS_URL=redis://localhost:6379

# AI
OPENAI_API_KEY=
AI_MODEL=gpt-4

# Unkey (API key verification + rate limiting - leave UNKEY_ROOT_KEY blank to
# fail open / allow all requests until a real Unkey workspace is set up)
UNKEY_ROOT_KEY=
UNKEY_API_ID=
UNKEY_BASE_URL=https://api.unkey.com/v2

# Application
DEBUG=false

# Integration
MARKETING_AUTOMATION_URL=http://localhost:8039
ANALYTICS_ENGINE_URL=http://localhost:8042
FUNNEL_AUTOMATION_URL=http://localhost:8000
